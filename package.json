{
  "name": "friendly-meals-web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "NODE_ENV=production react-router-serve ./build/server/index.js",
    "lint": "oxlint --type-aware --deny-warnings",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "typecheck": "react-router typegen && tsc -b",
    "upload:sourcemaps": "firebase crashlytics:sourcemap:upload build"
  },
  "dependencies": {
    "@firebase-oss/ui-core": "^7.1.0",
    "@firebase-oss/ui-react": "^7.1.0",
    "@hookform/resolvers": "^7.0.3",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@react-router/node": "^8.5.1",
    "@react-router/serve": "^8.5.1",
    "@tailwindcss/vite": "^4.3.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "firebase": "^13.2.0",
    "isbot": "^5",
    "lucide-react": "^1.70.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.80.0",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss": "^4.3.4"
  },
  "devDependencies": {
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/typography": "^0.5.19",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxc-transform-react": "^0.157.0",
    "oxfmt": "^0.77.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "overrides": {
    "@firebase-oss/ui-react": {
      "firebase": "$firebase"
    },
    "@firebase-oss/ui-core": {
      "firebase": "$firebase"
    }
  }
}
