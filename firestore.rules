rules_version = '2';

// ===============================================================
// Assumed Data Model
// ===============================================================
//
// Collection: recipes
// Document ID: auto-generated recipeId
// Public read: yes (required for unauthenticated Cloud Run SSR loaders and
//              Cloud CDN caching; contains no PII, only authorId UID)
// Fields:
//   - title: string (required, 1..200 chars)
//   - instructions: list<{ title: string, content: string }> (required, 1..50 steps)
//   - ingredients: list<string> (required, max 100 items)
//   - tags: list<string> (required, max 20 items)
//   - prepTime: string (required, 1..100 chars)
//   - cookTime: string (required, 1..100 chars)
//   - servings: string (required, 1..100 chars)
//   - authorId: string (required, immutable, matches request.auth.uid)
//   - imageUri: string (optional, http/https URL <= 2048 chars)
//   - createdAt: timestamp (optional, recipe creation timestamp)
//
// Subcollection: recipes/{recipeId}/reviews
// Document ID: {userId} (deterministic one-review-per-user-per-recipe;
//              or `seed-review-NN` for sample `seed-*` recipes owned by authorId)
// Public read: yes (aggregated in SSR/client pipelines; contains no PII)
// Fields:
//   - recipeId: string (required, immutable, matches parent {recipeId})
//   - userId: string (required, immutable, matches request.auth.uid)
//   - rating: number (required, 1..5)
//   - text: string (required, 0..2000 chars)
//
// Collection: likes
// Document ID: {recipeId}_{userId} (deterministic one-like-per-user-per-recipe;
//              or `{recipeId}_seed_like_NN` for sample `seed-*` recipes owned by authorId)
// Public read: yes (aggregated in SSR/client pipelines; contains no PII)
// Fields:
//   - recipeId: string (required, immutable, 1..128 chars)
//   - userId: string (required, immutable, matches request.auth.uid)
//
// ===============================================================

service cloud.firestore {
  match /databases/{database}/documents {
    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function hasRequiredFields(fields) {
      return request.resource.data.keys().hasAll(fields);
    }

    function hasOnlyAllowedFields(fields) {
      return request.resource.data.keys().hasOnly(fields);
    }

    function validStringLength(field, minLen, maxLen) {
      return request.resource.data[field] is string
        && request.resource.data[field].size() >= minLen
        && request.resource.data[field].size() <= maxLen;
    }

    function isValidOptionalUrl(field) {
      return !(field in request.resource.data)
        || (request.resource.data[field] is string
            && request.resource.data[field].size() <= 2048
            && (request.resource.data[field].matches("^https://.*")
                || request.resource.data[field].matches("^http://.*")));
    }

    function isValidOptionalTimestamp(field) {
      return !(field in request.resource.data)
        || request.resource.data[field] is timestamp;
    }

    // Validate element types/bounds for small tag lists (up to first 5 checked explicitly + list bound)
    function isValidBoundedList(field, maxLen) {
      return request.resource.data[field] is list
        && request.resource.data[field].size() <= maxLen
        && (request.resource.data[field].size() == 0
            || (request.resource.data[field][0] is string
                && request.resource.data[field][0].size() <= 200));
    }

    function isValidInstructionStep(step) {
      return step is map
        && step.keys().hasAll(['title', 'content'])
        && step.keys().hasOnly(['title', 'content'])
        && step.title is string
        && step.title.size() >= 1
        && step.title.size() <= 200
        && step.content is string
        && step.content.size() >= 1
        && step.content.size() <= 5000;
    }

    function isValidInstructionsList(field, maxLen) {
      return request.resource.data[field] is list
        && request.resource.data[field].size() >= 1
        && request.resource.data[field].size() <= maxLen
        && isValidInstructionStep(request.resource.data[field][0]);
    }

    // ===============================================================
    // Domain Validators
    // ===============================================================
    function isValidRecipe() {
      return hasRequiredFields([
          'title',
          'instructions',
          'ingredients',
          'tags',
          'prepTime',
          'cookTime',
          'servings',
          'authorId'
        ])
        && hasOnlyAllowedFields([
          'title',
          'instructions',
          'ingredients',
          'tags',
          'prepTime',
          'cookTime',
          'servings',
          'authorId',
          'imageUri',
          'createdAt'
        ])
        && validStringLength('title', 1, 200)
        && isValidInstructionsList('instructions', 50)
        && validStringLength('prepTime', 1, 100)
        && validStringLength('cookTime', 1, 100)
        && validStringLength('servings', 1, 100)
        && validStringLength('authorId', 1, 128)
        && isValidBoundedList('ingredients', 100)
        && isValidBoundedList('tags', 20)
        && isValidOptionalUrl('imageUri')
        && isValidOptionalTimestamp('createdAt');
    }

    function isSeedRecipeAuthor(recipeId) {
      let recipeDoc = get(/databases/$(database)/documents/recipes/$(recipeId));
      return isAuthenticated()
        && recipeId.matches('^seed-[a-z0-9-]+$')
        && recipeDoc != null
        && recipeDoc.data.authorId == request.auth.uid;
    }

    function isSeedLikeId(likeId, recipeId) {
      let prefix = recipeId + "_seed_like_";
      return likeId.size() > prefix.size()
        && likeId[0:prefix.size()] == prefix
        && likeId[prefix.size():likeId.size()].matches('^[0-9]{2}$');
    }

    function isValidReview(recipeId, reviewId) {
      return hasRequiredFields(['recipeId', 'userId', 'rating', 'text'])
        && hasOnlyAllowedFields(['recipeId', 'userId', 'rating', 'text'])
        && request.resource.data.recipeId == recipeId
        && request.resource.data.userId == request.auth.uid
        && (reviewId == request.auth.uid
            || (reviewId.matches('^seed-review-[0-9]{2}$')
                && isSeedRecipeAuthor(recipeId)))
        && request.resource.data.rating is number
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && validStringLength('text', 0, 2000);
    }

    function isValidLike(likeId) {
      let recipeId = request.resource.data.recipeId;
      return hasRequiredFields(['userId', 'recipeId'])
        && hasOnlyAllowedFields(['userId', 'recipeId'])
        && validStringLength('recipeId', 1, 128)
        && request.resource.data.userId == request.auth.uid
        && (likeId == recipeId + "_" + request.auth.uid
            || (isSeedLikeId(likeId, recipeId)
                && isSeedRecipeAuthor(recipeId)));
    }

    // ===============================================================
    // Collection Rules
    // ===============================================================
    match /recipes/{recipeId} {
      allow read: if true;
      allow create: if isOwner(request.resource.data.authorId) && isValidRecipe();
      allow update: if isOwner(resource.data.authorId)
                    && request.resource.data.authorId == resource.data.authorId
                    && isValidRecipe();
      allow delete: if isOwner(resource.data.authorId);

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated()
                      && (reviewId != request.auth.uid
                          || exists(/databases/$(database)/documents/recipes/$(recipeId)))
                      && isValidReview(recipeId, reviewId);
        allow update: if isOwner(resource.data.userId)
                      && request.resource.data.userId == resource.data.userId
                      && request.resource.data.recipeId == resource.data.recipeId
                      && isValidReview(recipeId, reviewId);
        allow delete: if isOwner(resource.data.userId);
      }
    }

    // Firestore Enterprise pipeline `subcollection("reviews")` subqueries are
    // authorized by Security Rules as collection-group reads across `{path=**}/reviews`.
    match /{path=**}/reviews/{reviewId} {
      allow read: if true;
    }

    match /likes/{likeId} {
      allow read: if true;
      allow create: if isAuthenticated()
                    && (likeId != request.resource.data.recipeId + "_" + request.auth.uid
                        || exists(/databases/$(database)/documents/recipes/$(request.resource.data.recipeId)))
                    && isValidLike(likeId);
      allow update: if isOwner(resource.data.userId)
                    && request.resource.data.userId == resource.data.userId
                    && request.resource.data.recipeId == resource.data.recipeId
                    && isValidLike(likeId);
      allow delete: if isOwner(resource.data.userId);
    }
  }
}
