{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json",
    "edition": "enterprise",
    "database": "friendlymeals"
  },
  "remoteconfig": {
    "template": "remoteconfig.template.json"
  },
  "apphosting": {
    "backendId": "friendly-meals",
    "rootDir": "/",
    "ignore": [
      "node_modules",
      ".git",
      "build",
      ".react-router",
      "firebase-debug.log",
      "firebase-debug.*.log"
    ]
  }
}
